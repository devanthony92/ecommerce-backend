# Copia este archivo a .env SOLO en el servidor. En desarrollo la API funciona sin .env
# (usa los valores por defecto de app/config.py).

# development | production
ENV=production

# postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://trama:CAMBIAR@localhost:5432/trama

# Clave para firmar los JWT. Obligatoria en producción. Genera una con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

JWT_EXPIRES_DAYS=7

# Orígenes del frontend permitidos (lista JSON).
CORS_ORIGINS=["https://tu-dominio.com","https://www.tu-dominio.com"]

# Carpeta de request.log y error.log
LOG_DIR=logs

# Dirección y puerto de uvicorn (detrás de nginx: 127.0.0.1)
HOST=127.0.0.1
PORT=3000
